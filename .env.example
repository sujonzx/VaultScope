# Dune Analytics integration. CRA only exposes env vars prefixed REACT_APP_.
# Copy this file to `.env` and fill in your values. Do not commit `.env`.
#
# WARNING: any value below is bundled into the client JS at build time and is
# visible to anyone who loads the page. Use a read-only Dune key, or proxy
# Dune calls through a backend.

REACT_APP_DUNE_API_KEY=

# Optional: Dune query IDs that power the dashboard. Leave blank to fall
# back to mock data for that slice. Get the ID from a Dune query URL
# (https://dune.com/queries/<ID>).

REACT_APP_DUNE_QUERY_VAULTS=
REACT_APP_DUNE_QUERY_TVL_HISTORY=
REACT_APP_DUNE_QUERY_EVENTS=
